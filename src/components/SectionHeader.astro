---
interface Props {
    id: string,
    title: string,
    description?: string,
    meta?: string,
    size?: number,
    hr?: boolean
}

const { id, title, description, meta, size = 1, hr = true } = Astro.props;

const fontSize = `clamp(
    ${2.25 * size}rem,
    ${4 * size}vw,
    ${2.25 * size}rem
)`;
---

<header>
    <div class="flex items-end justify-between gap-4">
        <h2
            id={id}
            class="font-display font-bold leading-[0.86] tracking-[-0.045em] text-bone"
            style={{fontSize}}
        >
            {title}
        </h2>
        {meta && (
            <p class="hidden pb-1 font-utility text-[0.65rem] uppercase tracking-[0.18em] text-mist sm:block">
                {meta}
            </p>
        )}
    </div>
    {
        hr && (
            <hr class="mt-5 border-0 border-t border-steel" />
        )
    }
    {
        description !== undefined && (
            <p class="body-text">{description}</p>
        )
    }
    <slot/>
</header>
