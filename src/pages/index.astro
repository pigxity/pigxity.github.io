---
import CardGroupList from '../components/CardGroupList.astro';
import SectionHeader from '../components/SectionHeader.astro';
import Tag from '../components/Tag.astro';
import Layout from '../layouts/Layout.astro';

import { ROBLOX_CARD_GROUP, MINECRAFT_GROUP } from '../content/cards';
import { TAGS } from '../content/tags';
import { MISC_GROUP } from '../content/cards';

const tags = Object.values(TAGS).filter((tag) => tag !== undefined);
---

<Layout>
	<div class="flex flex-col gap-24 sm:gap-32">
		<header class="flex min-h-[58svh] flex-col sm:min-h-[32svh] sm:justify-between">
			<div class="flex items-center justify-between gap-8 font-utility text-[0.65rem] uppercase tracking-[0.18em] text-mist">
				<p>Pigxity / Portfolio</p>
				<p class="flex items-center gap-2"><span class="size-1.5 rounded-full bg-signal" aria-hidden="true"></span> projects</p>
			</div>

			<div class="pt-24 sm:pt-32 mb-5">
				<h1 class="hero-title max-w-[13ch] font-display font-bold leading-[0.78] tracking-[-0.06em] text-bone">
					Pigxity's Portfolio
				</h1>
			</div>

			<p class="body-text">Welcome to my portfolio! Here are a few past projects I've worked on. Open source projects link to their GitHub repository; all are documented with at least a README file. A closed-source project, such as a game, would link to a website where it can be played/used.</p>
			<p class="body-text">Note that this page only includes selected public projects. Some are private and I don't want to release them. Some are omitted due to insignificance, but can be found on my <a class="text-signal hover:text-blue-400" href="https://github.com/pigxity">GitHub</a>.</p>
			<p class="body-text">Projects are ordered by significance. The best work (in my opinion) is at the top of each section.</p>
		</header>

		<section>
			<SectionHeader
				id="tag-index-title"
				title="Tags"
				description="Projects listed below may be tagged with the following:"
				size={0.8}
				hr={false}
			/>

			<p class="border-l border-steel pl-5 body-text"><b>About AI:</b> I do frequently use coding AI for new projects, but generated output is always reviewed for those tagged as <b>AI-Assisted</b>. Those tagged as <b>AI-Generated</b> are more or less <i>throwaway projects</i> where longevity doesn't matter. All projects here that use AI-generated code are tagged.</p>

			<ul class="mt-8 grid list-none gap-3 sm:mt-10 md:grid-cols-2" aria-label="Project tag definitions">
				{tags.map((tag) => <li><Tag tagData={tag} showDescription /></li>)}
			</ul>

			<p class="body-text mt-8 sm:mt-10">Anyways, on to the projects!</p>
		</section>

		<CardGroupList listData={ROBLOX_CARD_GROUP} tagRepository={TAGS}/>
		<CardGroupList listData={MINECRAFT_GROUP} tagRepository={TAGS}/>
		<CardGroupList listData={MISC_GROUP} tagRepository={TAGS}/>
	</div>

	<footer class="mt-24 flex flex-col gap-3 border-t border-steel py-8 font-utility text-[0.65rem] uppercase tracking-[0.16em] text-mist sm:mt-32 sm:flex-row sm:items-center sm:justify-between sm:py-10">
		<p>Pigxity / Portfolio</p>
		<p>(c) 2026 Pigxity | <a class="text-signal hover:text-blue-400" href="https://github.com/pigxity/pigxity.github.io">View the source code</a></p>
	</footer>
</Layout>
